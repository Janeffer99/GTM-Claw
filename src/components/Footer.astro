---
import { SITE } from '../consts';
const year = 2026;
---

<footer class="mt-24" style="border-top: 1px solid rgb(var(--border));">
  <div
    class="mx-auto flex max-w-[1360px] flex-col items-start justify-between gap-3 px-5 py-8 md:flex-row md:items-center md:px-8"
    style="color: rgb(var(--text-subtle)); font-size: 0.85rem;"
  >
    <div>© {year} {SITE.author} · {SITE.title}</div>
  </div>
</footer>
