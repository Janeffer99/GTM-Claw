---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'weeks'>;
}

const { entry } = Astro.props;
const { title, week, date, summary, tags } = entry.data;
const dateStr = date.toISOString().slice(0, 10);
const base = import.meta.env.BASE_URL;
---

<a
  href={`${base}weeks/${entry.id.replace(/\.mdx?$/, '')}/`}
  class="week-card group block rounded-xl p-6"
>
  <span class="week-card-glow" aria-hidden="true"></span>
  <span class="week-card-border" aria-hidden="true"></span>
  <div class="relative">
    <div class="flex items-center gap-3 text-xs" style="color: rgb(var(--text-subtle));">
      <span class="font-mono tracking-wide">{week}</span>
      <span aria-hidden="true">·</span>
      <time datetime={dateStr}>{dateStr}</time>
    </div>

    <h3
      class="mt-3 text-lg font-semibold tracking-tight transition group-hover:opacity-90"
      style="color: rgb(var(--text));"
    >
      {title}
    </h3>

    {summary && (
      <p class="mt-2 text-sm leading-relaxed" style="color: rgb(var(--text-muted));">
        {summary}
      </p>
    )}

    {tags && tags.length > 0 && (
      <div class="mt-4 flex flex-wrap gap-1.5">
        {tags.map((t: string) => (
          <span
            class="rounded-full px-2 py-0.5 text-[11px]"
            style="border: 1px solid rgb(var(--border)); color: rgb(var(--text-muted));"
          >{t}</span>
        ))}
      </div>
    )}
  </div>
</a>
