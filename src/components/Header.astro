---
import ThemeToggle from './ThemeToggle.astro';
import { SITE } from '../consts';
const base = import.meta.env.BASE_URL;
---

<header
  class="sticky top-0 z-40 backdrop-blur-md"
  style="background-color: rgb(var(--bg) / 0.75); border-bottom: 1px solid rgb(var(--border));"
>
  <div class="mx-auto flex h-14 max-w-[1360px] items-center justify-between px-5 md:px-8">
    <a href={base} class="flex items-center gap-2 group">
      <span
        class="inline-flex h-7 w-7 items-center justify-center rounded-md"
        style="background: rgb(var(--accent));"
        aria-hidden="true"
      >
        <svg width="14" height="14" viewBox="0 0 14 14" fill="none" xmlns="http://www.w3.org/2000/svg">
          <circle cx="7" cy="7" r="5.5" stroke="rgb(var(--accent-fg))" stroke-width="1.2" />
          <circle cx="7" cy="7" r="1.6" fill="rgb(var(--accent-fg))" />
        </svg>
      </span>
      <span class="text-sm font-medium tracking-tight" style="color: rgb(var(--text));">
        {SITE.title}
      </span>
    </a>

    <nav class="flex items-center gap-1">
      <ThemeToggle />
    </nav>
  </div>
</header>
